{
  "name": "agent-memory-mcp",
  "version": "0.1.0",
  "description": "Self-improving agent memory MCP server with knowledge graph, preference learning, and cross-workspace memory sharing",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-memory-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/full-test.sh && bash scripts/stress-test.sh && bash scripts/platform-check.sh"
  },
  "keywords": [
    "mcp",
    "memory",
    "knowledge-graph",
    "agent",
    "self-improvement"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "better-sqlite3": "^12.4.0",
    "chalk": "^5.4.1",
    "dotenv": "^16.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "http-server": "^14.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
